# DeliveryGate AI 真实模型客户端配置示例
# 复制为 .env 或直接在 shell 中 export；.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 只填空值/占位符，不存放真实 API Key。

# OpenAI 兼容接口 Base URL（不含 /chat/completions，客户端会自动拼接）
DELIVERYGATE_LLM_BASE_URL=

# Bearer Token（请通过环境变量注入，勿写入本文件提交）
DELIVERYGATE_LLM_API_KEY=

# 模型名称
DELIVERYGATE_LLM_MODEL=

# 单次请求超时（秒，默认 30）
DELIVERYGATE_LLM_TIMEOUT_SECONDS=30

# 显式开启真实 API 冒烟测试（可能产生费用）；默认不开启
DELIVERYGATE_RUN_REAL_API_TEST=0

# SQLite 数据库文件路径（可选；缺省为项目下 data/deliverygate.db）
DELIVERYGATE_DB_PATH=
